<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)..\'))" />

  <Target Name="GetMigrationPayload" Returns="@(_MigrationPayload)">
    <ItemGroup>
      <_MigrationPayload Include="$(TargetDir)**\*" />
      <_MigrationPayload>
        <RelativeDestination>Migration\$(MSBuildProjectName)\%(_MigrationPayload.RecursiveDir)%(_MigrationPayload.Filename)%(_MigrationPayload.Extension)</RelativeDestination>
      </_MigrationPayload>
    </ItemGroup>
  </Target>
</Project>
