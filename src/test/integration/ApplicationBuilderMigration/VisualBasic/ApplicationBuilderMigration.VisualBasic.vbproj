<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(NetCurrent)-windows7.0</TargetFramework>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <OutputType>Exe</OutputType>
    <RootNamespace></RootNamespace>
    <StartupObject>ApplicationBuilderMigration.VisualBasic.Program</StartupObject>
    <MyType>Empty</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <IsTestUtilityProject>true</IsTestUtilityProject>
    <IsPackable>false</IsPackable>
    <EnableXlfLocalization>false</EnableXlfLocalization>
    <UpdateXlfOnBuild>false</UpdateXlfOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Microsoft.VisualBasic.Forms\src\Microsoft.VisualBasic.Forms.vbproj" />
    <ProjectReference Include="..\..\..\..\System.Windows.Forms\System.Windows.Forms.csproj" />
  </ItemGroup>
</Project>
