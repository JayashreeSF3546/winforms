<Project>
  <PropertyGroup>
    <TargetFramework>$(NetCurrent)-windows7.0</TargetFramework>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <OutputType>Exe</OutputType>
    <IsTestUtilityProject>true</IsTestUtilityProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <EnableXlfLocalization>false</EnableXlfLocalization>
    <UpdateXlfOnBuild>false</UpdateXlfOnBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.vbproj'">
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <StartupObject>$(RootNamespace).Program</StartupObject>
    <MyType>Empty</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Presentation\ApplicationBuilderAdoption.Presentation.csproj" />
    <None Include="$(MSBuildProjectDirectory)\..\appsettings.json" Condition="Exists('$(MSBuildProjectDirectory)\..\appsettings.json')"
          Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
