<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCurrent)-windows7.0</TargetFramework>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <RootNamespace>System.Windows.Forms.UITests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <ParityWorkerProject Include="..\ApplicationBuilderParity\CSharp\ApplicationBuilderParity.CSharp.csproj" />
    <ParityWorkerProject Include="..\ApplicationBuilderParity\VisualBasic\ApplicationBuilderParity.VisualBasic.vbproj" />
    <ProjectReference Include="@(ParityWorkerProject)" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Forms\src\Microsoft.VisualBasic.Forms.vbproj" />
    <ProjectReference Include="..\..\..\Common\tests\TestUtilities\System.Private.Windows.Core.TestUtilities.csproj" />
    <ProjectReference Include="..\..\..\System.Design\src\System.Design.Facade.csproj" />
    <ProjectReference Include="..\..\..\System.Drawing.Design\src\System.Drawing.Design.Facade.csproj" />
    <ProjectReference Include="..\..\..\System.Windows.Forms.Primitives\src\System.Windows.Forms.Primitives.csproj" />
    <ProjectReference Include="..\..\..\System.Windows.Forms\System.Windows.Forms.csproj" />
    <ProjectReference Include="..\..\util\System.Windows.Forms\System.Windows.Forms.TestUtilities.csproj" />
    <ProjectReference Include="..\System.Windows.Forms.IntegrationTests.Common\System.Windows.Forms.IntegrationTests.Common.csproj" />
    <ProjectReference Include="..\WinFormsApplicationBuilder\CSharp\WinFormsApplicationBuilder.CSharp.csproj" />
    <ProjectReference Include="..\WinFormsApplicationBuilder\VisualBasic\WinFormsApplicationBuilder.VisualBasic.vbproj" />
    <ProjectReference Include="..\ApplicationBuilderScopes\CSharp\ApplicationBuilderScopes.CSharp.csproj" />
    <ProjectReference Include="..\ApplicationBuilderScopes\VisualBasic\ApplicationBuilderScopes.VisualBasic.vbproj" />
    <ProjectReference Include="..\ApplicationBuilderInfrastructure\CSharp\ApplicationBuilderInfrastructure.CSharp.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\ApplicationBuilderInfrastructure\VisualBasic\ApplicationBuilderInfrastructure.VisualBasic.vbproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\WinFormsApplicationLifetimePerformance\WinFormsApplicationLifetimePerformance.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WinFormsInfrastructurePerformance\WinFormsInfrastructurePerformance.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\3dwarro.cur">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\3dwno.cur">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Arc.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\DragAccept.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\DragAccept.rtf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\image.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\move.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyParityWorkers" AfterTargets="Build">
    <MSBuild Projects="@(ParityWorkerProject)"
             Targets="GetParityPayload"
             BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_ParityWorkerPayload" />
    </MSBuild>
    <Copy SourceFiles="@(_ParityWorkerPayload)"
          DestinationFiles="@(_ParityWorkerPayload->'$(TargetDir)%(RelativeDestination)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
