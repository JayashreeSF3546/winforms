<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(NetCurrent)-windows7.0</TargetFramework>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <OutputType>Exe</OutputType>
    <IsTestUtilityProject>true</IsTestUtilityProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableXlfLocalization>false</EnableXlfLocalization>
    <UpdateXlfOnBuild>false</UpdateXlfOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.Extensions.WinForms.Hosting\src\Microsoft.Extensions.WinForms.Hosting.csproj" />
    <ProjectReference Include="..\..\..\System.Windows.Forms\System.Windows.Forms.csproj" />
    <Compile Include="..\WinFormsApplicationLifetimePerformance\NativeMethods.cs" Link="NativeMethods.cs" />
  </ItemGroup>
</Project>
