<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCurrent)</TargetFramework>
    <Nullable>enable</Nullable>
    <CLSCompliant>true</CLSCompliant>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <UsePublicApiAnalyzers>true</UsePublicApiAnalyzers>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
    <IsShippingPackage>true</IsShippingPackage>
    <PackageDescription>Opt-in desktop configuration and typed user settings for the Windows Forms Application Builder using Microsoft.Extensions.Hosting.</PackageDescription>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\SettingsSR.resx">
      <GenerateSource>true</GenerateSource>
      <Namespace>Microsoft.Extensions.WinForms</Namespace>
    </EmbeddedResource>
  </ItemGroup>

</Project>
